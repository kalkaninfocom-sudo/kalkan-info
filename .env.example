# ==============================================================================
# Kalkan Info — Environment Variables Template
# ==============================================================================
# Kullanım:
#   1. Bu dosyayı kopyala: `cp .env.example .env.local`
#   2. .env.local içine gerçek değerleri gir
#   3. .env.local taahhüt edilmez (gitignore'da)
#   4. Vercel deploy için: Vercel Dashboard > Settings > Environment Variables
# ==============================================================================


# ==============================================================================
# SUPABASE (Faz 2 — zorunlu)
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                # PUBLIC — browser'a açık (RLS koruması)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...        # SECRET — server-only, ASLA browser'a sızdırma
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx   # Supabase CLI için (URL'in subdomain'i)
SUPABASE_DB_PASSWORD=                       # Postgres parolası (proje create sırasında verdiğin)


# ==============================================================================
# DIJITAL AI AGENT STACK — Multi-Agent Mimarisi
# ==============================================================================
# Birden fazla model + birden fazla agent rolü = optimum maliyet/kalite
# Strateji: Pahalı model = derin akıl yürütme, Haiku = hızlı/kısa çağrı

# --- API Keys ---
ANTHROPIC_API_KEY=sk-ant-...                # Primary: Claude (tatil, rehber, doğrulama)
GOOGLE_GEMINI_API_KEY=                      # LOA Workspace üzerinden Gemini 2.5 Pro/Flash
OPENAI_API_KEY=                             # Opsiyonel: GPT-4 alternatif/fallback

# --- Agent → Model Routing ---
# Hangi agent hangi modeli çağırır
AGENT_TATIL_PLANNER_MODEL=claude-sonnet-4-6     # 7 günlük tatil tasarımı (uzun reasoning)
AGENT_GEZGIN_REHBER_MODEL=claude-sonnet-4-6     # antik kent/Likya yolu rehberi (storytelling)
AGENT_PROVIDER_MATCHER_MODEL=claude-sonnet-4-6  # villa/restoran kullanıcıya eşleştirme
AGENT_NEWS_VERIFIER_MODEL=claude-sonnet-4-6     # haber kaynak doğrulama (tool use)
AGENT_MENU_CHEF_MODEL=claude-haiku-4-5          # restoran menü önerileri (hızlı, kısa)
AGENT_DIL_CEVIRMEN_MODEL=claude-haiku-4-5       # 5 dil real-time çeviri (TR/EN/RU/JA/AR)
AGENT_HAVA_PLAN_MODEL=claude-haiku-4-5          # hava durumuna göre program revizyonu
AGENT_SOCIAL_WRITER_MODEL=claude-haiku-4-5      # IG/X/FB/TikTok caption üretimi
AGENT_WHATSAPP_RECEPTION_MODEL=claude-haiku-4-5 # gelen WhatsApp mesajı triage

# --- Agent Genel Ayarları ---
AGENT_DEFAULT_TEMPERATURE=0.7
AGENT_DEFAULT_MAX_TOKENS=4096
AGENT_TIMEOUT_SECONDS=120

# --- Rate Limiting (maliyet kontrolü) ---
AGENT_DAILY_USER_LIMIT_ANON=1               # anon kullanıcı 1 plan/gün
AGENT_DAILY_USER_LIMIT_AUTH=5               # giriş yapan 5 plan/gün
AGENT_DAILY_BUDGET_USD=10                   # tüm agent çağrıları için günlük üst sınır


# ==============================================================================
# WHATSAPP BUSINESS API (Meta Cloud API)
# ==============================================================================
META_VERIFY_TOKEN=                          # 32 karakter random, sen belirle (webhook doğrulaması)
META_APP_SECRET=                            # Meta App → Settings → Basic → App Secret
META_PHONE_NUMBER_ID=                       # WhatsApp Cloud API phone number ID
META_ACCESS_TOKEN=                          # System User permanent access token
WHATSAPP_ALLOWLIST=+90XXXXXXXXXX            # virgülle ayrılmış admin telefonları


# ==============================================================================
# INSTAGRAM GRAPH API — Hashtag Widget (api/instagram-hashtag.js)
# Meta Developer Dashboard: https://developers.facebook.com/apps/2258853858192830
# ==============================================================================
META_APP_ID=2258853858192830                # Public — kalkan info Meta App ID
# META_APP_SECRET yukarıda (META_APP_SECRET) — Reset edip kullan
IG_BUSINESS_ID=                             # Graph API Explorer: me/accounts?fields=instagram_business_account{id}
IG_LONG_LIVED_TOKEN=                        # 60 gün geçerli, refresh edilebilir
IG_HASHTAG=kalkan.info                      # # olmadan, hangi etiket aranacak
IG_CRON_SECRET=                             # `openssl rand -hex 32` ile üret — cron tetikleme paylaşılan secret

# --- Eski Instagram Harvester (Faz B — şimdilik kullanılmıyor) ---
IG_ACCESS_TOKEN=                            # Eski; META_APP_SECRET + token sistemi kullanılır
IG_PROFILES=kalkan_info,kalkanvillas
IG_HARVEST_INTERVAL_HOURS=1


# ==============================================================================
# SOSYAL MEDYA POSTING (opsiyonel, mock'tan sonra)
# ==============================================================================
BUFFER_API_KEY=
PUBLER_API_KEY=


# ==============================================================================
# EMAIL — Resend.com (3000 mail/ay ücretsiz)
# ==============================================================================
RESEND_API_KEY=re_...                       # resend.com → API Keys
EMAIL_FROM=Kalkan Info <noreply@kalkaninfo.com>
EMAIL_REPLY_TO=info@kalkaninfo.com
EMAIL_DEV_REDIRECT=                         # geliştirme: her mail bu adrese yönlensin (opsiyonel)


# ==============================================================================
# GOOGLE OAUTH (Supabase Auth provider — Supabase Dashboard'a girilir)
# Bunlar .env'de tutulmaz, sadece referans:
# ==============================================================================
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...


# ==============================================================================
# MONITORING & ANALYTICS (opsiyonel)
# ==============================================================================
SENTRY_DSN=                                 # error tracking (kalkan-info-prod sentry projesi)
ANALYTICS_GA4_ID=G-XXXXXXXXXX               # Google Analytics 4 measurement ID


# ==============================================================================
# RESERVATION / EXTERNAL APIS (Faz 3+)
# ==============================================================================
SKYSCANNER_API_KEY=                         # uçuş arama (Partner onayı bekliyor)
AMADEUS_CLIENT_ID=                          # alternatif: Amadeus Self-Service
AMADEUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=                        # Open-Meteo anahtarsız, bu opsiyonel


# ==============================================================================
# DEV / SERVER
# ==============================================================================
NODE_ENV=development
PORT=3010
VERCEL_URL=                                 # otomatik set edilir (production'da kalkaninfo.com)
